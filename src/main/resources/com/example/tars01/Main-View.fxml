                <Label fx:id="horaActual" layoutX="26.0" layoutY="661.0" prefHeight="24.0" prefWidth="324.0" style="-fx-text-fill: white;" visible="false">
                    <font>
                        <Font name="JetBrains Mono Bold" size="21.0" />
                    </font>
                    <opaqueInsets>
                        <Insets />
                    </opaqueInsets>
                </Label>
                <Label fx:id="info" layoutX="517.0" layoutY="73.0" prefHeight="20.0" prefWidth="828.0" textFill="#e4f800">
                    <font>
                        <Font name="JetBrains Mono Bold" size="14.0" />
                    </font>
                    <opaqueInsets>
                        <Insets />
                    </opaqueInsets>
                </Label>
                <TextField fx:id="textFieldChange" editable="false" layoutX="117.0" layoutY="603.0" prefHeight="51.0" prefWidth="195.0" style="-fx-background-color: #222831; -fx-text-fill: white; -fx-background-radius: 10; -fx-border-radius: 10;" visible="false">
                    <font>
                        <Font name="JetBrains Mono Bold" size="25.0" />
                    </font>
                </TextField>
                <Label fx:id="TCambio" layoutX="19.0" layoutY="617.0" style="-fx-text-fill: WHITE;" text="Cambio" textFill="WHITE" visible="false">
                    <font>
                        <Font name="JetBrains Mono Bold" size="21.0" />
                    </font>
                </Label>
                <TextField fx:id="precio" disable="true" layoutX="45.0" layoutY="49.0" prefHeight="24.0" prefWidth="116.0">
