                    <TableView fx:id="tableSearchQuery" layoutX="22.0" layoutY="59.0" prefHeight="349.0" prefWidth="427.0" />
               <effect>
                  <Blend />
               </effect>
                </AnchorPane>
            <TextArea fx:id="obser" layoutX="517.0" layoutY="536.0" prefHeight="83.0" prefWidth="278.0" promptText="Ingrese una observación sobre la venta si es necesario" style="-fx-background-radius: 10; -fx-background-color: #222831; -fx-border-radius: 10; -fx-text-fill: white; -fx-control-inner-background: #222831; -fx-fill: white;" visible="false" wrapText="true" />
            <JFXTreeTableView fx:id="tableView" layoutX="19.0" layoutY="93.0" prefHeight="387.0" prefWidth="490.0" stylesheets="@nombre.css">
               <columnResizePolicy>
                  <TreeTableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy></JFXTreeTableView>


            </children>


        </AnchorPane>


    </children>


</VBox>
