               </font></TextField>
                <Label fx:id="labelItem2" alignment="CENTER" layoutX="18.0" layoutY="48.0" prefHeight="25.0" prefWidth="23.0" style="-fx-text-fill: WHITE;" text="\$" textFill="WHITE">
