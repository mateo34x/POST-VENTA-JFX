                        <Font name="JetBrains Mono Bold" size="18.0" />
                    </font>
                </Label>
                <TextArea fx:id="ReciboViewVenta" editable="false" layoutX="517.0" layoutY="76.0" prefHeight="402.0" prefWidth="286.0" style="-fx-background-radius: 10; -fx-border-radius: 10;" visible="false">
                    <font>
                        <Font name="Monospaced Bold" size="11.0" />
                    </font>
                </TextArea>
                <TextField fx:id="Nventa" alignment="TOP_LEFT" editable="false" layoutX="239.0" layoutY="48.0" opacity="0.69" prefHeight="20.0" prefWidth="103.0" style="-fx-text-fill: WHITE; -fx-background-color: #191919;" text="90">
