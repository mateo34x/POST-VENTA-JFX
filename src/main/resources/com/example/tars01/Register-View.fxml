<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: #31363F;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.tars01.RegistreController">
    <children>
        <Label layoutX="250.0" layoutY="50.0" style="-fx-text-fill: #FFFFFF;" text="Registro" />
        <TextField fx:id="nombreVerdaderoField" layoutX="200.0" layoutY="100.0" prefWidth="200.0" promptText="Nombre Verdadero" style="-fx-border-color: #FFFFFF; -fx-text-fill: #F5E8C7;" />
        <TextField fx:id="nombreUsuarioField" layoutX="200.0" layoutY="150.0" prefWidth="200.0" promptText="Nombre de usuario" style="-fx-border-color: #FFFFFF; -fx-text-fill: #F5E8C7;" />
        <PasswordField fx:id="passwordField" layoutX="200.0" layoutY="200.0" prefWidth="200.0" promptText="Contraseña" style="-fx-border-color: #FFFFFF; -fx-text-fill: #F5E8C7;" />
        <Button layoutX="250.0" layoutY="250.0" mnemonicParsing="false" onAction="#guardar" prefWidth="100.0" text="Guardar" />
        <Label fx:id="messageLabel" alignment="CENTER" layoutX="180.0" layoutY="300.0" prefHeight="18.0" prefWidth="250.0" style="-fx-text-fill: #ED2B2A;" textFill="RED" />
        <Button fx:id="Volver" layoutX="10.0" layoutY="10.0" mnemonicParsing="false" onAction="#volver" prefWidth="75.0" text="Volver al login" />
    </children>
</AnchorPane>
