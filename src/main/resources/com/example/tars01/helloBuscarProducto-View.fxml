<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="450.0" prefWidth="640.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.tars01.EditController">
    <children>

        <AnchorPane prefHeight="768.0" prefWidth="1360" style="-fx-background-color: #31363F;" VBox.vgrow="ALWAYS">
            <children>
                <TextField fx:id="textFieldItemEdit" layoutX="45.0" layoutY="19.0" prefHeight="27.0" prefWidth="349.0" />
                <Button layoutX="404.0" layoutY="20.0" mnemonicParsing="false" style="-fx-background-color: #5C5470;" text="Limpiar" textFill="WHITE" />
                <Label fx:id="hora" layoutX="480.0" layoutY="23.0" prefHeight="16.0" prefWidth="208.0" style="-fx-text-fill: white;" text="HH:mm:ss">
                    <font>
                        <Font size="14.0" />
                    </font>
                    <opaqueInsets>
                        <Insets />
                    </opaqueInsets>
                </Label>
                <Label fx:id="info" layoutX="45.0" layoutY="416.0" prefHeight="16.0" prefWidth="303.0" style="-fx-text-fill: white;" text="Sin novedades">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                    <opaqueInsets>
                        <Insets />
                    </opaqueInsets>
                </Label>
            <TableView layoutX="45.0" layoutY="59.0" prefHeight="349.0" prefWidth="613.0" />
            </children>
        </AnchorPane>
    </children>
</VBox>
