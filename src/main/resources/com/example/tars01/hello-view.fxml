<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: #31363F;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.tars01.LoginController">
    <children>
        <Label layoutX="280.0" layoutY="100.0" style="-fx-text-fill: #FFFFFF;" text="Login" />
        <TextField fx:id="usernameField" layoutX="200.0" layoutY="150.0" prefWidth="200.0" promptText="Username" style="-fx-border-color: #FFFFFF; -fx-text-fill: #000000;" />
        <PasswordField fx:id="passwordField" layoutX="200.0" layoutY="200.0" prefWidth="200.0" promptText="Password" style="-fx-border-color: #FFFFFF; -fx-text-fill: #000000;" AnchorPane.bottomAnchor="174.0" AnchorPane.leftAnchor="200.0" AnchorPane.rightAnchor="200.0" AnchorPane.topAnchor="200.0" />
        <Button layoutX="250.0" layoutY="250.0" mnemonicParsing="false" onAction="#login" prefWidth="100.0" text="Login" />
        <Label fx:id="messageLabel" alignment="CENTER" layoutX="180.0" layoutY="300.0" prefHeight="18.0" prefWidth="250.0" style="-fx-text-fill: #ED2B2A;" textFill="RED" />
      <Button fx:id="R" layoutX="518.0" layoutY="350.0" mnemonicParsing="false" onAction="#Registro" text="Registro" />
    </children>
</AnchorPane>
