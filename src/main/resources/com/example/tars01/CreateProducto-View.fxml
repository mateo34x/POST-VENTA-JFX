<?xml version="1.0" encoding="UTF-8"?>

<?import io.github.palexdev.materialfx.controls.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.tars01.CreateProductController">
   <children>
      <MenuBar style="-fx-background-color: #DBD8E3;" useSystemMenuBar="true" VBox.vgrow="ALWAYS">
         <menus>
            <Menu mnemonicParsing="false" text="Vistas">
               <items>
                  <MenuItem disable="true" mnemonicParsing="false" text="Crear Producto" />
                  <MenuItem fx:id="editar" mnemonicParsing="false" onAction="#cargarVistaEditar" text="Editar Producto" />
                  <MenuItem fx:id="venta" mnemonicParsing="false" onAction="#cargarVistaVenta" text="Nueva venta" />
                  <MenuItem fx:id="buscar" mnemonicParsing="false" onAction="#cargarVistaBuscar" text="Buscar venta" />
               </items>
            </Menu>
            <Menu mnemonicParsing="false" text="Servidor">
               <items>
                  <MenuItem fx:id="seeCreate" mnemonicParsing="false" text="Encender" />
               </items>
            </Menu>
            <Menu mnemonicParsing="false" text="Help">
               <items>
                  <MenuItem mnemonicParsing="false" text="Coming soon" />
               </items>
            </Menu>
         </menus>
      </MenuBar>
      <AnchorPane prefHeight="768.0" prefWidth="1360" style="-fx-background-color: #31363F;" VBox.vgrow="ALWAYS">
         <children>
            <Button fx:id="saveCreate" disable="true" layoutX="46.0" layoutY="252.0" mnemonicParsing="false" onAction="#save" prefHeight="35.0" prefWidth="149.0" style="-fx-background-color: #20615B;" text="Crear" textAlignment="CENTER" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
            </Button>
            <Label fx:id="horaCreate" layoutX="416.0" layoutY="25.0" prefHeight="16.0" prefWidth="208.0" style="-fx-text-fill: white;">
               <font>
                  <Font size="20.0" />
               </font>
               <opaqueInsets>
                  <Insets />
               </opaqueInsets>
            </Label>
            <MFXListView layoutX="62.0" layoutY="50.0" prefHeight="0.0" prefWidth="368.0" />
            <TextField fx:id="nameCreate" layoutX="46.0" layoutY="52.0" prefHeight="35.0" prefWidth="223.0" />
            <Label layoutX="46.0" layoutY="25.0" prefHeight="27.0" prefWidth="95.0" style="-fx-text-fill: WHITE;" text="Nombre" textFill="WHITE">
               <font>
                  <Font name="Calibri" size="18.0" />
               </font>
            </Label>
            <TextField fx:id="priceCreate" layoutX="46.0" layoutY="124.0" prefHeight="35.0" prefWidth="223.0" />
            <Label layoutX="46.0" layoutY="97.0" prefHeight="27.0" prefWidth="66.0" style="-fx-text-fill: WHITE;" text="Precio" textFill="WHITE">
               <font>
                  <Font name="Calibri" size="18.0" />
               </font>
            </Label>
            <TextField fx:id="codeCreate" layoutX="46.0" layoutY="193.0" prefHeight="35.0" prefWidth="223.0" />
            <Label layoutX="46.0" layoutY="166.0" prefHeight="27.0" prefWidth="66.0" style="-fx-text-fill: WHITE;" text="Codigo" textFill="WHITE">
               <font>
                  <Font name="Calibri" size="18.0" />
               </font>
            </Label>
            <Label fx:id="infoCreate" alignment="TOP_LEFT" layoutX="46.0" layoutY="312.0" prefHeight="172.0" prefWidth="313.0" style="-fx-text-fill: white;" text="Sin novedades">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
               <opaqueInsets>
                  <Insets />
               </opaqueInsets>
            </Label>
            <TableView fx:id="tableViewShow" layoutX="416.0" layoutY="56.0" nodeOrientation="LEFT_TO_RIGHT" prefHeight="593.0" prefWidth="788.0">
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
            <Button fx:id="showProductos" layoutX="416.0" layoutY="657.0" mnemonicParsing="false" onAction="#obtenerTodosLosProductos" prefHeight="35.0" prefWidth="237.0" style="-fx-background-color: #20615B;" text="Mostrar todos lo productos" textAlignment="CENTER" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
            </Button>
         </children>
      </AnchorPane>
   </children>
</VBox>
